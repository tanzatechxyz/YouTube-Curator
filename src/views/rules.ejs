<%- include("partials/head") %>
<%- include("partials/header") %>
<div class="page-heading">
  <div>
    <p class="eyebrow">Filtering</p>
    <h1>Rules</h1>
    <p>The first enabled rule that matches decides whether to reject the video or which playlists receive it.</p>
  </div>
</div>

<section class="panel">
  <div class="panel-heading">
    <div>
      <p class="eyebrow">Fallback</p>
      <h2>When no rule matches</h2>
    </div>
  </div>
  <form method="post" action="/rules/default" class="inline-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>
      Default outcome
      <select name="defaultOutcome">
        <option value="reject" <%= defaultOutcome === "reject" ? "selected" : "" %>>Reject the video</option>
        <option value="accept" <%= defaultOutcome === "accept" ? "selected" : "" %>>Accept using fallback playlists</option>
      </select>
    </label>
    <button class="button secondary" type="submit">Save default</button>
  </form>
</section>

<section class="panel">
  <div class="panel-heading">
    <div>
      <p class="eyebrow">New filter</p>
      <h2>Add a rule</h2>
    </div>
  </div>
  <form method="post" action="/rules" class="rule-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>
      Name
      <input name="name" maxlength="80" placeholder="Keep weekly highlights" required>
    </label>
    <label>
      Action
      <select name="action">
        <option value="accept">Add to playlist(s)</option>
        <option value="reject">Reject</option>
      </select>
    </label>
    <label>
      Field
      <select name="field">
        <option value="channel">Channel name</option>
        <option value="duration">Duration (minutes)</option>
        <option value="title">Title</option>
        <option value="description">Description</option>
      </select>
    </label>
    <label>
      Comparison
      <select name="operator">
        <optgroup label="Text and channel">
          <option value="contains">contains</option>
          <option value="not_contains">does not contain</option>
          <option value="equals" selected>equals / is exactly</option>
          <option value="regex">matches regex</option>
        </optgroup>
        <optgroup label="Duration">
          <option value="less_than">is shorter than</option>
          <option value="at_most">is at most</option>
          <option value="at_least">is at least</option>
          <option value="greater_than">is longer than</option>
        </optgroup>
      </select>
    </label>
    <label class="rule-value">
      Match value
      <input name="value" maxlength="500" list="channel-suggestions" placeholder="Channel name, text, or minutes" required>
      <small>For duration, enter minutes such as 10 or 12.5.</small>
    </label>
    <fieldset class="rule-destinations">
      <legend>Destination playlists</legend>
      <% if (playlists.length) { %>
        <div class="rule-playlist-options">
          <% playlists.forEach((playlist) => { %>
            <label>
              <input name="playlistIds" type="checkbox" value="<%= playlist.id %>">
              <span><%= playlist.title %></span>
            </label>
          <% }) %>
        </div>
        <small>Required when the action is “Add to playlist(s)”; ignored for reject rules.</small>
      <% } else { %>
        <p class="muted-copy">Sync your playlists before creating an accepting rule. <a class="text-link" href="/playlists">Open playlists →</a></p>
      <% } %>
    </fieldset>
    <button class="button primary" type="submit">Add rule</button>
  </form>
  <datalist id="channel-suggestions">
    <% subscriptions.forEach((subscription) => { %>
      <option value="<%= subscription.title %>"></option>
    <% }) %>
  </datalist>
</section>

<section class="panel">
  <div class="panel-heading">
    <div>
      <p class="eyebrow">Evaluation order</p>
      <h2>Configured rules</h2>
    </div>
    <span class="environment"><%= rules.length %> total</span>
  </div>
  <% if (rules.length) { %>
    <% const fieldLabels = { title: "title", description: "description", channel: "channel name", duration: "duration" }; %>
    <% const operatorLabels = { contains: "contains", not_contains: "does not contain", equals: "equals", regex: "matches regex", less_than: "is shorter than", at_most: "is at most", at_least: "is at least", greater_than: "is longer than" }; %>
    <ol class="rule-list">
      <% rules.forEach((rule, index) => { %>
        <li class="<%= rule.enabled ? '' : 'disabled-row' %>">
          <span class="rule-order"><%= index + 1 %></span>
          <div class="rule-copy">
            <div class="rule-title">
              <h3><%= rule.name %></h3>
              <span class="decision-badge <%= rule.action %>"><%= rule.action === "accept" ? "route" : "reject" %></span>
              <% if (!rule.enabled) { %><span class="status-pill muted">Disabled</span><% } %>
            </div>
            <p>
              <strong><%= fieldLabels[rule.field] || rule.field %></strong>
              <%= operatorLabels[rule.operator] || rule.operator %>
              <code><%= rule.value %><%= rule.field === "duration" ? " minutes" : "" %></code>
            </p>
            <% if (rule.action === "accept") { %>
              <div class="rule-targets">
                <span>→</span>
                <% if (rule.playlistTitles.length) { %>
                  <% rule.playlistTitles.forEach((title) => { %><span class="tag"><%= title %></span><% }) %>
                <% } else { %>
                  <span class="warning-copy">No destination playlist — edit this rule</span>
                <% } %>
              </div>
            <% } %>
          </div>
          <div class="rule-actions">
            <form method="post" action="/rules/<%= rule.id %>/move">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="direction" value="up">
              <button class="icon-button" type="submit" title="Move up" <%= index === 0 ? "disabled" : "" %>>↑</button>
            </form>
            <form method="post" action="/rules/<%= rule.id %>/move">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="direction" value="down">
              <button class="icon-button" type="submit" title="Move down" <%= index === rules.length - 1 ? "disabled" : "" %>>↓</button>
            </form>
            <a class="button secondary small-button" href="/rules/<%= rule.id %>/edit">Edit</a>
            <form method="post" action="/rules/<%= rule.id %>/toggle">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="button secondary small-button" type="submit"><%= rule.enabled ? "Disable" : "Enable" %></button>
            </form>
            <form method="post" action="/rules/<%= rule.id %>/delete">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="icon-button danger-text" type="submit" title="Delete rule">×</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ol>
  <% } else { %>
    <div class="empty-state compact">
      <h3>No rules yet</h3>
      <p>The safe default is to reject videos until you add a routing rule.</p>
    </div>
  <% } %>
</section>
<%- include("partials/footer") %>
