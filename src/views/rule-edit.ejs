<%- include("partials/head") %>
<%- include("partials/header") %>
<div class="page-heading">
  <div>
    <p class="eyebrow">Filtering</p>
    <h1>Edit rule</h1>
    <p>Changes apply only to videos discovered after you save.</p>
  </div>
  <a class="button secondary" href="/rules">Cancel</a>
</div>

<section class="panel">
  <div class="panel-heading">
    <div>
      <p class="eyebrow">Metadata rule</p>
      <h2><%= rule.name %></h2>
    </div>
  </div>
  <form method="post" action="/rules/<%= rule.id %>" class="rule-form" data-rule-builder>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include("partials/rule-builder", { rule, submitLabel: "Save rule" }) %>
  </form>
  <datalist id="channel-suggestions">
    <% subscriptions.forEach((subscription) => { %>
      <option value="<%= subscription.title %>"></option>
    <% }) %>
  </datalist>
</section>
<script src="/assets/rules.js" defer></script>
<%- include("partials/footer") %>
