<%- include("partials/head") %>
<%- include("partials/header") %>
<div class="page-heading">
  <div>
    <p class="eyebrow">Manual mode</p>
    <h1>Review queue</h1>
    <p>Approve matching videos before the app changes your playlists.</p>
  </div>
  <span class="status-pill <%= videos.length ? 'warning' : 'good' %>">
    <span class="status-dot"></span>
    <%= videos.length %> waiting
  </span>
</div>

<section class="review-list" aria-label="Videos awaiting review">
  <% if (videos.length) { %>
    <% videos.forEach((video) => { %>
      <article class="review-card">
        <a class="video-thumbnail" href="https://www.youtube.com/watch?v=<%= video.video_id %>" target="_blank" rel="noreferrer">
          <% if (video.thumbnail_url) { %>
            <img src="<%= video.thumbnail_url %>" alt="">
          <% } else { %>
            <span aria-hidden="true">▶</span>
          <% } %>
        </a>
        <div class="review-copy">
          <p class="video-channel"><%= video.channel_title %></p>
          <h2>
            <a href="https://www.youtube.com/watch?v=<%= video.video_id %>" target="_blank" rel="noreferrer"><%= video.title %></a>
          </h2>
          <p class="video-description"><%= video.description %></p>
          <div class="reason-box">
            <span>Why it matched</span>
            <p><%= video.decision_reason %></p>
          </div>
          <div class="reason-box">
            <span>Rule destinations</span>
            <% if (video.destinations.length) { %>
              <div class="tag-list">
                <% video.destinations.forEach((destination) => { %>
                  <span class="tag"><%= destination.playlist_title %></span>
                <% }) %>
              </div>
            <% } else { %>
              <p>No destination was recorded; approval will use configured fallback playlists.</p>
            <% } %>
          </div>
          <p class="video-meta">
            Published <%= video.published_at %>
            <% if (video.durationLabel) { %> · <%= video.durationLabel %><% } %>
          </p>
        </div>
        <div class="review-actions">
          <form method="post" action="/review/<%= video.video_id %>/approve">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="button primary" type="submit">Approve</button>
          </form>
          <form method="post" action="/review/<%= video.video_id %>/reject">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="button secondary" type="submit">Reject</button>
          </form>
        </div>
      </article>
    <% }) %>
  <% } else { %>
    <div class="panel empty-state">
      <div class="empty-icon" aria-hidden="true">✓</div>
      <h2>Queue clear</h2>
      <p>New videos accepted by your rules will appear here in manual-review mode.</p>
    </div>
  <% } %>
</section>
<%- include("partials/footer") %>
